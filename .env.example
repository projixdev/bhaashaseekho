# MongoDB Atlas connection string (Database > Connect > Drivers).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Database name inside the Atlas cluster (created automatically on first write).
MONGODB_DB=bhaashaseekho

# Brevo transactional email — API key from Brevo dashboard > SMTP & API > API Keys.
BREVO_API_KEY=replace-with-real-brevo-api-key

# Sender email address, must be a verified sender in your Brevo account.
BREVO_SENDER_EMAIL=noreply@bhaashaseekho.com

# Where lead/contact notification emails are sent — the client's inbox.
CLIENT_NOTIFICATION_EMAIL=client@bhaashaseekho.com

# Client's WhatsApp number in international format, digits only, no + or spaces
# (e.g. 919876543210). Used to build the wa.me click-to-chat link.
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000

# Google Tag Manager container ID (format GTM-XXXXXXX). Leave unset locally —
# GTM scripts render nothing until this is provided by the client.
NEXT_PUBLIC_GTM_ID=

# Public site URL, used for metadata and sitemap.xml. Use the live domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
